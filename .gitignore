# Criar/atualizar .gitignore
cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
roms/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo

# Mirai específico
data/cache/*
data/logs/*
!data/.gitkeep
!data/*/.gitkeep

config/gemini_key.txt
config/local_*.json
.env

# Temporários
*.tmp
*.log
temp/
temp_audio/

# Sistema
.DS_Store
Thumbs.db
EOF